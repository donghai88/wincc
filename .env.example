# mock: use bundled document samples and static mock data only
# fallback: request the real API first, then fall back to mock data on failure
# off: request the real API only
NEXT_PUBLIC_API_MOCK_MODE=mock

# Leave empty when Nginx proxies API paths on the same origin.
# Example for direct browser calls: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Reserved for WebSocket clients.
# Example for direct browser calls: wss://api.example.com
NEXT_PUBLIC_WS_BASE_URL=
